rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'admin@lalbicut.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // ── bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Lecture publique : nécessaire pour vérifier les créneaux disponibles
      // (slot/date/status) sans être connecté. Les données PII sont acceptables
      // dans ce contexte (barber shop local, pas de données médicales/bancaires).
      allow read: if true;

      // Tout le monde peut créer une réservation (clients connectés ou non)
      // Validation : status initial = pending, prix dans une fourchette raisonnable
      allow create: if request.resource.data.status == 'pending' &&
                       request.resource.data.price is number &&
                       request.resource.data.price >= 0 &&
                       request.resource.data.price <= 100 &&
                       request.resource.data.clientName is string &&
                       request.resource.data.clientName.size() <= 80 &&
                       request.resource.data.clientEmail is string &&
                       request.resource.data.clientEmail.size() <= 254 &&
                       request.resource.data.clientPhone is string &&
                       request.resource.data.clientPhone.size() <= 20;

      // Mise à jour :
      // - Admin : toutes modifications
      // - Client connecté : uniquement annuler SES propres réservations (rien d'autre)
      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.status == 'cancelled' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      // Suppression : admin uniquement
      allow delete: if isAdmin();
    }

    // ── settings (créneaux bloqués + programme fidélité) ─────────────────────
    match /settings/{docId} {
      // Lecture publique nécessaire pour le flow de réservation
      allow read: if true;
      // Écriture : admin uniquement
      allow write: if isAdmin();
    }
  }
}
